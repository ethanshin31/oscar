# Your Anthropic API key from https://console.anthropic.com (keep it secret, never commit it)
ANTHROPIC_API_KEY=

# The passphrase you type to unlock Oscar on a new device. Make it long.
OSCAR_ACCESS_CODE=

# What Oscar calls you
OSCAR_USER_NAME=Peter

# Home location for the globe, used when the device doesn't share its position
OSCAR_HOME_NAME=Mississippi, USA
OSCAR_HOME_LAT=32.30
OSCAR_HOME_LON=-90.18
